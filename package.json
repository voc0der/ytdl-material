    },
    "flatted": "3.4.4",
    "hono": "4.13.3",
    "immutable": "5.1.9",
    "js-yaml": "4.3.1",
    "nanoid": "3.3.18",
    "postcss": "8.5.26",
    "tmp": "0.2.7",
    "ws": "8.21.3"
  }
}
