{
  "name": "ytdl-material",
  "version": "1.2.2",
  "license": "MIT",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "codespaces": "ng serve --configuration=codespaces",
    "build": "ng build --configuration production",
    "prebuild": "node src/postbuild.mjs",
    "heroku-postbuild": "npm install --prefix backend",
    "test": "ng test --browsers Chromium",
    "test:headless": "ng test --watch=false",
    "test:extension": "node --test chrome-extension/test/extension.test.mjs",
    "package:extension": "node chrome-extension/package.mjs",
    "lint": "eslint --ext .ts,.js src backend",
    "generate": "openapi --input ./\"Public API v1.yaml\" --output ./src/api-types --exportCore false --exportServices false --exportModels true",
    "i18n-source": "ng extract-i18n --output-path=src/assets/i18n --out-file=messages.en.xlf"
  },
  "engines": {
    "node": ">=24 <26",
    "npm": ">=10"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^22.2.0",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/localize": "^22.2.0",
    "@angular/material": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@ngneat/content-loader": "^7.0.0",
    "@videogular/ngx-videogular": "^20.0.0",
    "bootstrap": "^5.3.8",
    "filesize": "^11.0.24",
    "material-icons": "^1.13.14",
    "ngx-avatars": "^1.10.2",
    "ngx-file-drop": "^16.0.0",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "typescript": "~6.0.3",
    "zone.js": "~0.16.3"
  },
  "devDependencies": {
    "@angular-devkit/core": "^22.2.0",
    "@angular/build": "^22.2.0",
    "@angular/cli": "^22.2.0",
    "@angular/compiler-cli": "^22.2.0",
    "@angular/language-service": "^22.2.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.2",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "@vitest/coverage-v8": "^5.0.1",
    "ajv": "^8.20.0",
    "eslint": "^10.11.0",
    "fs-extra": "^11.4.1",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "openapi-typescript-codegen": "^0.31.0",
    "vitest": "^5.0.1",
    "xliff-to-json": "^1.1.0"
  }
}
