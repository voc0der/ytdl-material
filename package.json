{
  "name": "ytdl-material",
  "version": "1.0.10",
  "license": "MIT",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "codespaces": "ng serve --configuration=codespaces",
    "build": "ng build --configuration production",
    "prebuild": "node src/postbuild.mjs",
    "heroku-postbuild": "npm install --prefix backend",
    "test": "ng test --browsers Chromium",
    "test:headless": "ng test --watch=false",
    "lint": "eslint --ext .ts,.js src",
    "electron": "ng build --base-href ./ && electron .",
    "generate": "openapi --input ./\"Public API v1.yaml\" --output ./src/api-types --exportCore false --exportServices false --exportModels true",
    "i18n-source": "ng extract-i18n --output-path=src/assets/i18n --out-file=messages.en.xlf"
  },
  "engines": {
    "node": ">=24 <26",
    "npm": ">=10"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.1.2",
    "@angular/cdk": "^22.1.0",
    "@angular/common": "^22.1.2",
    "@angular/compiler": "^22.1.2",
    "@angular/core": "^22.1.2",
    "@angular/forms": "^22.1.2",
    "@angular/localize": "^22.1.2",
    "@angular/material": "^22.1.0",
    "@angular/platform-browser": "^22.1.2",
    "@angular/platform-browser-dynamic": "^22.1.2",
    "@angular/router": "^22.1.2",
    "@fontsource/material-icons": "^5.3.0",
    "@ngneat/content-loader": "^7.0.0",
    "@videogular/ngx-videogular": "^20.0.0",
    "core-js": "^3.49.0",
    "crypto-js": "^4.2.0",
    "file-saver": "^2.0.2",
    "filesize": "^11.0.22",
    "fs-extra": "^11.4.0",
    "material-icons": "^1.10.8",
    "nan": "^2.28.0",
    "ngx-avatars": "1.10.2",
    "ngx-file-drop": "^16.0.0",
    "rxjs": "^7.8.2",
    "tslib": "^2.0.0",
    "typescript": "~6.0.3",
    "xliff-to-json": "^1.0.4",
    "zone.js": "~0.16.2"
  },
  "devDependencies": {
    "@angular-devkit/core": "^22.1.4",
    "@angular/build": "^22.1.4",
    "@angular/cli": "^22.1.4",
    "@angular/compiler-cli": "^22.1.2",
    "@angular/language-service": "^22.1.2",
    "@eslint/js": "^10.0.1",
    "@types/core-js": "^2.5.2",
    "@types/file-saver": "^2.0.1",
    "@types/node": "^26.2.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitest/coverage-v8": "^4.1.11",
    "ajv": "^8.20.0",
    "eslint": "^10.8.1",
    "globals": "^17.8.0",
    "jsdom": "^30.0.1",
    "openapi-typescript-codegen": "^0.31.0",
    "ts-node": "~10.9.2",
    "vitest": "^4.0.8"
  },
  "overrides": {
    "@hono/node-server": "2.1.1",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@angular/build": {
      "picomatch": "4.0.5"
    },
    "@angular-devkit/core": {
      "ajv": "8.20.0",
      "picomatch": "4.0.5"
    },
    "esbuild": "0.28.2",
    "express-rate-limit": "8.6.2",
    "ngx-avatars": {
