{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "outDir": "../out-tsc/spec",
    "baseUrl": "",
    // Vitest and Angular localize ship global types in their own packages.
    "typeRoots": [
      "../node_modules/@types",
      "../node_modules"
    ],
    "types": [
      "node",
      "vitest/globals",
      "@angular/localize"
    ]
  },
  "files": [
    "test-setup.ts"
  ],
  "include": [
    "**/*.spec.ts",
    "**/*.d.ts"
  ],
  "angularCompilerOptions": {
    "extendedDiagnostics": {
      "checks": {
        "nullishCoalescingNotNullable": "suppress",
        "optionalChainNotNullable": "suppress"
      }
    }
  }
}
